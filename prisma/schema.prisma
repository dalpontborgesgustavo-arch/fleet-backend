  createdBy User?                        @relation("EnvironmentalRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?                        @relation("EnvironmentalRecordUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([domain, competence])
  @@index([company, competence])
  @@index([metric, competence])
  @@index([site])
  @@index([factorId])
  @@index([createdById])
  @@index([updatedById])
  @@index([active])
}

