model LucasFleetRevenueSyncRun {
  id                   String                         @id @default(uuid())
  runId                String                         @unique
  schemaVersion        String
  dataset              String
  source               String
  ruleVersion          String
  ruleHash             String
  mode                 String
  generatedAt          DateTime                       @db.Timestamptz(6)
  scopeDateFrom        DateTime                       @db.Date
  scopeDateToExclusive DateTime                       @db.Date
  scopeBranches        String[]
  scopeCompanies       String[]
  scopeMetadata        Json
  snapshotStartedAt    DateTime                       @db.Timestamptz(6)
  snapshotFinishedAt   DateTime                       @db.Timestamptz(6)
  snapshotComplete     Boolean
  dryRun               Boolean
  allowedForPosting    Boolean
  batchTotal           Int
  status               String                         @default("IN_PROGRESS")
  receivedBatchCount   Int                            @default(0)
  receivedRecordCount  Int                            @default(0)
  finalizedRecordCount Int?
  finalizedAmountTotal Decimal?                       @db.Decimal(65, 30)
  manifest             Json?
  completedAt          DateTime?                      @db.Timestamptz(6)
  failedAt             DateTime?                      @db.Timestamptz(6)
  failureReason        String?
  createdAt            DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                       @updatedAt @db.Timestamptz(6)
  batches              LucasFleetRevenueSyncBatch[]
  stagedFacts          LucasFleetRevenueStagingFact[]
  canonicalFacts       LucasFleetRevenueFact[]        @relation("LucasFleetRevenueLastRun")

  @@unique([dataset, runId])
  @@index([status, generatedAt])
  @@index([scopeDateFrom, scopeDateToExclusive])
}

model LucasFleetRevenueSyncBatch {
  id                  String                   @id @default(uuid())
  runDbId             String
  batchNumber         Int
  batchTotal          Int
  producerPayloadHash String
  serverPayloadHash   String
  recordCount         Int
  response            Json
  processedAt         DateTime                 @default(now()) @db.Timestamptz(6)
  run                 LucasFleetRevenueSyncRun @relation(fields: [runDbId], references: [id], onDelete: Restrict)

  @@unique([runDbId, batchNumber])
  @@index([producerPayloadHash])
  @@index([serverPayloadHash])
}

model LucasFleetRevenueStagingFact {
  id              String                   @id @default(uuid())
  runDbId         String
  nativeLocator   String
  sourceKind      String
  nativeKey       Json
  companyId       String
  sourceKey       String
  aethosVehicleId String
  eventDate       DateTime                 @db.Date
  competence      DateTime                 @db.Date
  amount          Decimal?                 @db.Decimal(65, 30)
  sourceStatus    String?
  active          Boolean
  sourceUpdatedAt DateTime?                @db.Timestamptz(6)
  planAccountId   String?
  recordHash      String
  raw             Json?
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  run             LucasFleetRevenueSyncRun @relation(fields: [runDbId], references: [id], onDelete: Cascade)

  @@unique([runDbId, nativeLocator])
  @@index([runDbId, competence])
  @@index([aethosVehicleId, competence])
}

model LucasFleetRevenueFact {
  id                 String                       @id @default(uuid())
  dataset            String
  source             String
  nativeLocator      String
  sourceKind         String
  nativeKey          Json
  companyId          String
  sourceKey          String
  aethosVehicleId    String
  eventDate          DateTime                     @db.Date
  competence         DateTime                     @db.Date
  amount             Decimal?                     @db.Decimal(65, 30)
  sourceStatus       String?
  active             Boolean                      @default(true)
  sourceUpdatedAt    DateTime?                    @db.Timestamptz(6)
  planAccountId      String?
  recordHash         String
  raw                Json?
  lastRunId          String
  deactivatedAt      DateTime?                    @db.Timestamptz(6)
  deactivationReason String?
  syncedAt           DateTime                     @default(now()) @db.Timestamptz(6)
  createdAt          DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                     @updatedAt @db.Timestamptz(6)
  lastRun            LucasFleetRevenueSyncRun     @relation("LucasFleetRevenueLastRun", fields: [lastRunId], references: [id], onDelete: Restrict)
  audits             LucasFleetRevenueFactAudit[]

  @@unique([dataset, source, nativeLocator])
  @@index([aethosVehicleId, competence, active])
  @@index([companyId, competence, active])
  @@index([lastRunId])
}

model LucasFleetRevenueFactAudit {
  id         BigInt                @id @default(autoincrement())
  factId     String
  operation  String
  syncRunId  String
  beforeData Json?
  afterData  Json?
  changedAt  DateTime              @default(now()) @db.Timestamptz(6)
  fact       LucasFleetRevenueFact @relation(fields: [factId], references: [id], onDelete: Restrict)

  @@index([factId, changedAt])
  @@index([syncRunId])
}

