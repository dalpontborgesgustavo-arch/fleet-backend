generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Filial {
  MATRIZ
  NORTE
  MAFRA
  PEDRAFORTE
  NAO_CLASSIFICADA
}

enum RollerType {
  CHAPA
  PNEU
  TERRAPLANAGEM
}

model User {
  id                              String                        @id @default(uuid())
  email                           String                        @unique
  name                            String
  password                        String
  role                            String
  active                          Boolean                       @default(true)
  mustChangePassword              Boolean                       @default(false)
  phone                           String?
  city                            String?
  tipoFrota                       String?
  filial                          Filial                        @default(MATRIZ)
  canAccessTopographyInventory    Boolean                       @default(false)
  canExecuteMaintenance           Boolean                       @default(false)
  canAccessFleetTracking          Boolean                       @default(false)
  canAccessFleetOverview          Boolean                       @default(false)
  canAccessFleetUtilization       Boolean                       @default(false)
  canAccessFleetAlerts            Boolean                       @default(false)
  canAccessFleetVideo             Boolean                       @default(false)
  canAccessBucketActivations      Boolean                       @default(false)
  createdAt                       DateTime                      @default(now())
  occurrences                     Occurrence[]
  checklists                      Checklist[]
  monthlyResponsibleChecklists    Checklist[]                   @relation("ChecklistMonthlyResponsible")
  rncsEngineer                    Rnc[]                         @relation("RncEngineer")
  rncsReviewed                    Rnc[]                         @relation("RncReviewer")
  rncsResponsible                 Rnc[]                         @relation("RncResponsible")
  rncsEffectivenessReviewed       Rnc[]                         @relation("RncEffectivenessReviewer")
  rncSystemItemsIncluded          Rnc[]                         @relation("RncSystemItemIncludedBy")
  rncItemsIncluded                RncItem[]                     @relation("RncItemIncludedBy")
  rncAttachmentsUploaded          RncAttachment[]               @relation("RncAttachmentUploadedBy")
  rncCorrectiveActionsResponsible RncCorrectiveAction[]         @relation("RncCorrectiveActionResponsible")
  rncCorrectiveActionsCompleted   RncCorrectiveAction[]         @relation("RncCorrectiveActionCompletedBy")
  rncHistory                      RncHistory[]                  @relation("RncHistoryActor")
  rncAssignmentsSent              RncAssignment[]               @relation("RncAssignmentAssignedBy")
  rncAssignmentsReceived          RncAssignment[]               @relation("RncAssignmentAssignedTo")
  rncEmailTokensReceived          RncEmailToken[]               @relation("RncEmailTokenTargetUser")
  pushTokens                      UserPushToken[]
  topographyArrivals              TopographyArrival[]
  topographyInventoriesCreated    TopographyInventory[]         @relation("TopographyInventoryCreatedBy")
  topographyInventoriesUpdated    TopographyInventory[]         @relation("TopographyInventoryUpdatedBy")
  topographyInventoryHistory      TopographyInventoryHistory[]  @relation("TopographyInventoryHistoryActor")
  revenueForecasts                RevenueForecast[]             @relation("RevenueForecastCreatedBy")
  taxForecastsUpdated             TaxForecast[]                 @relation("TaxForecastUpdatedBy")
  usinaForecastsUpdated           UsinaForecast[]               @relation("UsinaForecastUpdatedBy")
  usinaForecastHistory            UsinaForecastHistory[]        @relation("UsinaForecastHistoryActor")
  ssmaLicenses                    SsmaLicense[]                 @relation("SsmaLicenseCreatedBy")
  ssmaRenewals                    SsmaLicenseRenewal[]          @relation("SsmaRenewalCreatedBy")
  environmentalRecordsCreated     EnvironmentalRecord[]         @relation("EnvironmentalRecordCreatedBy")
  environmentalRecordsUpdated     EnvironmentalRecord[]         @relation("EnvironmentalRecordUpdatedBy")
  environmentalFactorsCreated     EnvironmentalEmissionFactor[] @relation("EnvironmentalFactorCreatedBy")
  hrCommunications                HrCommunication[]             @relation("HrCommunicationCreatedBy")
  refreshTokens                   RefreshToken[]
  budgetScenarios                 BudgetScenario[]              @relation("BudgetScenarioCreatedBy")
  monthlyChecklistVehicles        Vehicle[]                     @relation("VehicleMonthlyChecklistResponsible")

  @@index([filial])
}

model UserPushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String?
  deviceId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastSeenAt])
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ConstructionControlState {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AethosObra {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  clientName String?
  rawId      String?
  active     Boolean  @default(true)
  syncedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([name])
  @@index([clientName])
  @@index([active])
}

model AethosItem {
  id          String   @id @default(uuid())
  code        String   @unique
  description String
  unit        String?
  rawId       String?
  active      Boolean  @default(true)
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([description])
  @@index([active])
}

model AethosObraCusto {
  id          String   @id @default(uuid())
  code        String
  name        String?
  competencia String
  custoTotal  Decimal  @db.Decimal(18, 2)
  origem      String
  raw         Json?
  active      Boolean  @default(true)
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([code, competencia, origem])
  @@index([code])
  @@index([competencia])
  @@index([active])
}

model AethosPurchaseOrder {
  id                   String                       @id @default(uuid())
  sourceOrderId        String
  number               String
  companyCode          String
  companyName          String?
  supplierName         String?
  issuedAt             DateTime                     @db.Date
  competence           String
  status               String
  sourceStatus         String?
  approvalStatus       String
  sourceApprovalStatus String?
  requesterName        String?
  buyerName            String?
  pendingApproverName  String?
  pendingApproval      Json?
  approvedByName       String?
  approvedAt           DateTime?
  expectedDeliveryAt   DateTime?                    @db.Date
  totalAmount          Decimal                      @db.Decimal(18, 3)
  notes                String?                      @db.Text
  raw                  Json?
  sourceUpdatedAt      DateTime?
  extractedAt          DateTime
  active               Boolean                      @default(true)
  contentHash          String
  lastRunId            String
  syncedAt             DateTime                     @default(now())
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  items                AethosPurchaseOrderItem[]
  history              AethosPurchaseOrderHistory[]

  @@unique([companyCode, sourceOrderId])
  @@index([competence, active])
  @@index([status])
  @@index([approvalStatus])
  @@index([companyCode])
  @@index([pendingApproverName])
  @@index([pendingApproval], type: Gin)
}

model AethosPurchaseOrderItem {
  id                   String              @id @default(uuid())
  orderId              String
  sourceItemId         String
  lineType             String              @default("ITEM")
  description          String
  quantity             Decimal?            @db.Decimal(18, 6)
  unit                 String?
  unitPrice            Decimal?            @db.Decimal(18, 6)
  totalAmount          Decimal             @db.Decimal(18, 3)
  accountCode          String?
  accountName          String?
  pendingAmount        Decimal?            @db.Decimal(18, 3)
  approvedAmount       Decimal?            @db.Decimal(18, 3)
  openCommitmentAmount Decimal?            @db.Decimal(18, 3)
  raw                  Json?
  active               Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  order                AethosPurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, sourceItemId])
  @@index([accountCode])
  @@index([orderId, active])
}

model AethosPurchaseOrderHistory {
  id                   String              @id @default(uuid())
  orderId              String
  runId                String
  status               String
  sourceStatus         String?
  approvalStatus       String
  sourceApprovalStatus String?
  totalAmount          Decimal             @db.Decimal(18, 3)
  active               Boolean
  pendingApproverName  String?
  pendingApproval      Json?
  contentHash          String
  extractedAt          DateTime
  snapshot             Json
  createdAt            DateTime            @default(now())
  order                AethosPurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([runId])
}

model AethosPurchaseOrderSyncRun {
  id             String   @id @default(uuid())
  runId          String   @unique
  payloadHash    String
  extractedAt    DateTime
  receivedCount  Int
  appliedCount   Int
  staleCount     Int
  unchangedCount Int
  createdAt      DateTime @default(now())
}

model BudgetVersion {
  id          String   @id @default(uuid())
  year        Int
  name        String
  baseRevenue Decimal  @db.Decimal(18, 2)
  active      Boolean  @default(true)
  importedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines     BudgetLine[]
  scenarios BudgetScenario[]

  @@unique([year, name])
  @@index([year, active])
}

model BudgetLine {
  id              String   @id @default(uuid())
  versionId       String
  idSubgrupo      String
  descricao       String
  annualCost      Decimal  @db.Decimal(18, 2)
  monthlyCost     Decimal  @db.Decimal(18, 2)
  referenceYear   Int
  comparisonValue Decimal? @db.Decimal(18, 2)
  responsible     String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  version        BudgetVersion       @relation(fields: [versionId], references: [id], onDelete: Cascade)
  monthlyBudgets BudgetMonthlyLine[]

  @@unique([versionId, idSubgrupo, descricao])
  @@index([versionId])
  @@index([idSubgrupo])
  @@index([responsible])
  @@index([active])
}

model BudgetMonthlyLine {
  id          String   @id @default(uuid())
  lineId      String
  year        Int
  month       Int
  amount      Decimal  @db.Decimal(18, 2)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  line BudgetLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([lineId, year, month])
  @@index([year, month])
  @@index([lineId])
}

model BudgetScenario {
  id          String   @id @default(uuid())
  versionId   String
  name        String
  revenue     Decimal  @db.Decimal(18, 2)
  year        Int
  month       Int?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  version   BudgetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("BudgetScenarioCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([versionId])
  @@index([year, month])
  @@index([createdById])
}

model AethosSubgroupActual {
  id             String   @id @default(uuid())
  matchKey       String   @unique
  idSubgrupo     String
  descricao      String?
  competencia    String
  valorRealizado Decimal  @db.Decimal(18, 2)
  origem         String
  obra           String?
  centroCusto    String?
  raw            Json?
  active         Boolean  @default(true)
  syncedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([idSubgrupo])
  @@index([competencia])
  @@index([active])
  @@index([syncedAt])
}

model AethosPlanoContaCost {
  id                     String    @id @default(uuid())
  matchKey               String    @unique
  idLancamento           String
  codigoEmpresa          String?
  nomeEmpresa            String?
  codigoPlanoConta       String
  nomePlanoConta         String?
  competencia            String
  dataBaseLancamento     DateTime?
  dataLancamento         DateTime?
  dataVencimento         DateTime?
  temNotaFiscal          Boolean   @default(false)
  idNotaFiscal           String?
  numeroNotaFiscal       String?
  dataEmissaoNotaFiscal  DateTime?
  observacaoLancamento   String?   @db.Text
  observacaoNotaFiscal   String?   @db.Text
  valorCusto             Decimal   @db.Decimal(18, 2)
  valorPago              Decimal?  @db.Decimal(18, 2)
  valorSaldo             Decimal?  @db.Decimal(18, 2)
  status                 String?
  statusDescricao        String?
  tipoDocumento          String?
  tipoDocumentoDescricao String?
  origem                 String
  raw                    Json?
  active                 Boolean   @default(true)
  deactivatedAt          DateTime?
  deactivationReason     String?
  reconciliationId       String?
  syncedAt               DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([origem, idLancamento])
  @@index([codigoPlanoConta])
  @@index([competencia])
  @@index([origem])
  @@index([status])
  @@index([active])
  @@index([reconciliationId])
  @@index([syncedAt])
  @@index([dataBaseLancamento])
  @@index([dataLancamento])
  @@index([dataEmissaoNotaFiscal])
}

model AethosPlanoContaCostReconciliation {
  id                   String   @id @default(uuid())
  reconciliationId     String   @unique
  payloadHash          String
  origin               String
  rule                 String
  requestedCount       Int
  foundCount           Int
  deactivatedCount     Int
  alreadyInactiveCount Int
  notFoundCount        Int
  totalValue           Decimal  @db.Decimal(18, 2)
  idLancamentos        Json
  metadata             Json?
  executedAt           DateTime @default(now())

  @@index([origin])
  @@index([rule])
  @@index([executedAt])
}

model AethosContract {
  id                        String                     @id @default(uuid())
  aethosId                  String                     @unique
  quotationAethosId         String?
  companyAethosId           String
  workAethosId              String
  workName                  String
  contractorAethosId        String
  contractorName            String
  registeredAt              DateTime
  startDate                 DateTime?
  endDate                   DateTime?
  finalizedAt               DateTime?
  contractedAt              DateTime?
  lastContractedAt          DateTime?
  contractedByUser          String?
  originalValue             Decimal                    @db.Decimal(18, 2)
  statusCode                String
  statusDescription         String
  notes                     String?                    @db.Text
  engineerAethosId          String?
  engineerName              String?
  retentionValue            Decimal?                   @db.Decimal(18, 2)
  anticipatedRetentionValue Decimal?                   @db.Decimal(18, 2)
  retentionBalance          Decimal?                   @db.Decimal(18, 2)
  totalMeasuredValue        Decimal?                   @db.Decimal(18, 2)
  payableBalance            Decimal?                   @db.Decimal(18, 2)
  measurementBalance        Decimal?                   @db.Decimal(18, 2)
  contractBalance           Decimal?                   @db.Decimal(18, 2)
  contractQuantity          Decimal?                   @db.Decimal(18, 4)
  movesFinancial            Boolean?
  returnsWorkBalance        Boolean?
  accountPlanAethosId       String?
  accountPlanName           String?
  cancellationReason        String?                    @db.Text
  generatedAttachments      Json?
  source                    String                     @default("AETHOS")
  contentHash               String
  lastSeenSyncId            String?
  raw                       Json?
  active                    Boolean                    @default(true)
  syncedAt                  DateTime                   @default(now())
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  attachments               AethosContractAttachment[]
  workflow                  ContractWorkflow?

  @@index([companyAethosId])
  @@index([workAethosId])
  @@index([contractorAethosId])
  @@index([statusCode])
  @@index([contractedAt])
  @@index([active])
  @@index([syncedAt])
  @@index([lastSeenSyncId])
}

model AethosContractAttachment {
  id                 String         @id @default(uuid())
  aethosId           String         @unique
  contractId         String
  documentAethosId   String
  documentTypeAethos String
  fileName           String
  description        String?        @db.Text
  extension          String?
  mimeType           String?
  sizeBytes          Int?
  md5                String?
  includedAt         DateTime?
  storageType        String
  sourceReference    String
  fileKey            String?
  fileUrl            String?
  fileReceivedAt     DateTime?
  source             String         @default("AETHOS")
  raw                Json?
  active             Boolean        @default(true)
  syncedAt           DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  contract           AethosContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([active])
  @@index([md5])
  @@index([syncedAt])
}

model ContractWorkflow {
  id                 String                  @id @default(uuid())
  contractId         String                  @unique
  type               String
  status             String                  @default("IN_PROGRESS")
  outcomeAt          DateTime?
  cancellationReason String?                 @db.Text
  notes              String?                 @db.Text
  updatedById        String?
  updatedByName      String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  contract           AethosContract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  stages             ContractWorkflowStage[]

  @@index([type])
  @@index([status])
  @@index([updatedAt])
}

model ContractWorkflowStage {
  id               String           @id @default(uuid())
  workflowId       String
  key              String
  sequence         Int
  label            String
  responsible      String
  targetDays       Int?
  targetUnit       String?
  targetComparison String?
  completedAt      DateTime?
  notes            String?          @db.Text
  updatedById      String?
  updatedByName    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  workflow         ContractWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, key])
  @@index([workflowId, sequence])
  @@index([completedAt])
}

model ThirdPartyMeasurement {
  id                              String                                 @id @default(uuid())
  aethosMeasurementId             String                                 @unique
  aethosContractId                String
  aethosWorkId                    String
  workName                        String
  workContract                    String?
  contractorAethosId              String
  contractorName                  String
  engineerAethosId                String?
  engineerName                    String?
  measurementNumber               String?
  measurementDescription          String?                                @db.Text
  registeredAt                    DateTime?
  startDate                       DateTime?
  endDate                         DateTime?
  competenceDate                  DateTime?
  dueDate                         DateTime?
  finalizedAt                     DateTime?
  finalized                       Boolean                                @default(false)
  measurementValue                Decimal?                               @db.Decimal(18, 2)
  discountValue                   Decimal?                               @db.Decimal(18, 2)
  retentionValue                  Decimal?                               @db.Decimal(18, 2)
  totalValue                      Decimal?                               @db.Decimal(18, 2)
  contractValue                   Decimal?                               @db.Decimal(18, 2)
  totalMeasuredValue              Decimal?                               @db.Decimal(18, 2)
  contractStatus                  String?
  measurementNotes                String?                                @db.Text
  contractNotes                   String?                                @db.Text
  engineerDeliveryDate            DateTime?
  engineerDeliveryTargetDate      DateTime?
  engineerDelayReason             String?                                @db.Text
  measurementApproved             Boolean?
  rejectionReason                 String?                                @db.Text
  resolutionDate                  DateTime?
  zanandraDeliveryDate            DateTime?
  invoiceRequestDate              DateTime?
  contractorDocumentsDeliveryDate DateTime?
  zanandraDeliveryTargetDate      DateTime?
  invoiceRequestTargetDate        DateTime?
  contractorDocumentsTargetDate   DateTime?
  actualPaymentDate               DateTime?
  type                            String?
  administrativeNotes             String?                                @db.Text
  source                          String                                 @default("AETHOS")
  contentHash                     String
  raw                             Json?
  syncedAt                        DateTime                               @default(now())
  createdAt                       DateTime                               @default(now())
  updatedAt                       DateTime                               @updatedAt
  items                           ThirdPartyMeasurementItem[]
  history                         ThirdPartyMeasurementHistory[]
  legacyImportRows                ThirdPartyMeasurementLegacyImportRow[]

  @@index([aethosContractId])
  @@index([aethosWorkId])
  @@index([contractorAethosId])
  @@index([engineerAethosId])
  @@index([competenceDate])
  @@index([dueDate])
  @@index([finalized])
  @@index([syncedAt])
}

model ThirdPartyMeasurementItem {
  id                      String                @id @default(uuid())
  measurementId           String
  aethosMeasurementItemId String                @unique
  aethosContractId        String
  measurementNumber       String?
  aethosWorkId            String
  aethosContractItemId    String?
  aethosBudgetItemId      String?
  itemDescription         String                @db.Text
  contractQuantity        Decimal?              @db.Decimal(18, 4)
  contractValue           Decimal?              @db.Decimal(18, 2)
  measuredQuantity        Decimal?              @db.Decimal(18, 4)
  measuredPercentage      Decimal?              @db.Decimal(9, 4)
  measuredValue           Decimal?              @db.Decimal(18, 2)
  balanceQuantity         Decimal?              @db.Decimal(18, 4)
  balanceValue            Decimal?              @db.Decimal(18, 2)
  raw                     Json?
  syncedAt                DateTime              @default(now())
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  measurement             ThirdPartyMeasurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)

  @@index([measurementId])
  @@index([aethosContractId])
  @@index([aethosWorkId])
  @@index([aethosContractItemId])
}

model ThirdPartyMeasurementHistory {
  id            String                @id @default(uuid())
  measurementId String
  action        String
  changedFields Json
  actorId       String?
  actorName     String?
  createdAt     DateTime              @default(now())
  measurement   ThirdPartyMeasurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)

  @@index([measurementId, createdAt])
  @@index([actorId])
}

model ThirdPartyMeasurementLegacyImportBatch {
  id                   String                                 @id @default(uuid())
  sourceFileName       String
  sourceFileSha256     String
  candidateFileSha256  String
  exceptionsFileSha256 String
  fingerprint          String                                 @unique
  status               String                                 @default("PENDING")
  candidateCount       Int
  exceptionMatrixCount Int
  appliedCount         Int                                    @default(0)
  unchangedCount       Int                                    @default(0)
  conflictCount        Int                                    @default(0)
  actorName            String?
  metadata             Json?
  startedAt            DateTime                               @default(now())
  completedAt          DateTime?
  rolledBackAt         DateTime?
  createdAt            DateTime                               @default(now())
  updatedAt            DateTime                               @updatedAt
  rows                 ThirdPartyMeasurementLegacyImportRow[]
  exceptions           ThirdPartyMeasurementLegacyException[]

  @@index([status, createdAt])
}

model ThirdPartyMeasurementLegacyImportRow {
  id             String                                 @id @default(uuid())
  batchId        String
  measurementId  String
  sourceRow      Int
  payloadSha256  String
  classification String                                 @default("MATCH_UNICO")
  status         String
  sourcePayload  Json
  previousValues Json
  appliedValues  Json
  createdAt      DateTime                               @default(now())
  updatedAt      DateTime                               @updatedAt
  batch          ThirdPartyMeasurementLegacyImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  measurement    ThirdPartyMeasurement                  @relation(fields: [measurementId], references: [id], onDelete: Restrict)

  @@unique([batchId, sourceRow, payloadSha256])
  @@index([measurementId, createdAt])
  @@index([batchId, status])
}

model ThirdPartyMeasurementLegacyException {
  id                  String                                 @id @default(uuid())
  batchId             String
  matrixRow           Int
  exceptionType       String
  groupKey            String?
  sourceRowA          Int?
  sourceRowB          Int?
  contractNumber      String?
  measurementNumber   String?
  workNumber          String?
  aethosMeasurementId String?
  fieldName           String?
  valueA              String?
  valueB              String?
  comparison          String?
  reason              String?                                @db.Text
  proposedAction      String?                                @db.Text
  payloadSha256A      String?
  payloadSha256B      String?
  raw                 Json
  status              String                                 @default("PENDING")
  createdAt           DateTime                               @default(now())
  updatedAt           DateTime                               @updatedAt
  batch               ThirdPartyMeasurementLegacyImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([batchId, matrixRow])
  @@index([batchId, exceptionType])
  @@index([aethosMeasurementId])
}

model ThirdPartyMeasurementSla {
  id              String   @id @default(uuid())
  key             String   @unique
  label           String
  baseDateField   String
  targetDateField String
  days            Int?
  unit            String   @default("BUSINESS_DAYS")
  active          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
}

model BucketActivationAddress {
  id         String   @id @default(uuid())
  key        String   @unique
  latitude   Float
  longitude  Float
  address    String
  source     String
  raw        Json?
  resolvedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([latitude, longitude])
  @@index([resolvedAt])
}

model BucketActivationDailySnapshot {
  date                   String   @id
  payload                Json
  eventCount             Int      @default(0)
